# Copiar a .env y editar. El .env NO se sube al repo.
#
#   cp env.ejemplo .env && nano .env

# ── La clave del administrador ────────────────────────────────────────
# Se aplica SOLO en el primer arranque, al crear el directorio de datos.
# Si ya arrancaste una vez con la de fabrica, borra ./datos y vuelve a
# empezar, o cambiala desde el panel.
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=CAMBIA-ESTO-POR-UNA-CLAVE-LARGA

# ── La memoria ────────────────────────────────────────────────────────
# Xmx no mas de la MITAD del RAM libre (`free -h`). Con 4 GB totales y
# Django+Postgres encima, 1g es sensato; con 8 GB, 2g.
GS_XMS=512m
GS_XMX=1g
# Techo duro del contenedor: el Xmx mas lo que la JVM usa fuera del heap.
GS_MEM_LIMIT=1536m

# ── Como lo publica nginx ─────────────────────────────────────────────
# Tiene que coincidir con el location de nginx-geoserver.conf, o los
# enlaces que genera el panel apuntaran a donde no es.
GS_HOST=nexhydro.jriegopresurizado.org.pe
GS_PROXY_BASE=https://nexhydro.jriegopresurizado.org.pe/geoserver

# ── Donde viven los rasters ───────────────────────────────────────────
# Fuera del directorio de datos: son gigas y no se respaldan igual.
GS_RASTERS=/var/www/geodatos
